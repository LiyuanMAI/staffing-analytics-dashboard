{
  "name": "staffing-analytics-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:export": "tsx scripts/export-data.ts",
    "format": "prettier --write src tests scripts *.ts *.json *.html *.yaml .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts *.ts *.json *.html *.yaml .github/workflows/*.yml"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "prettier": "^3.6.0"
  }
}
